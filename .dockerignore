# Explicit allowlist: discard each directory subtree before admitting its source files.
**
!Dockerfile
!.dockerignore
!requirements.txt
!backend
backend/**
!backend/app
backend/app/**
!backend/app/*.py
!backend/app/api
backend/app/api/**
!backend/app/api/*.py
!backend/app/api/routes
backend/app/api/routes/**
!backend/app/api/routes/*.py
!backend/app/api/schemas
backend/app/api/schemas/**
!backend/app/api/schemas/*.py
!backend/app/db
backend/app/db/**
!backend/app/db/*.py
!backend/app/integrations
backend/app/integrations/**
!backend/app/integrations/*.py
!backend/app/services
backend/app/services/**
!backend/app/services/*.py
!external
external/**
!external/kirill_db
external/kirill_db/**
!external/kirill_db/db.py
!external/hackathon_event_analyzer
external/hackathon_event_analyzer/**
!external/hackathon_event_analyzer/event_analyzer.py
!simulator
simulator/**
!simulator/*.py
!demo
demo/**
!demo/synthetic.csv
!frontend
frontend/**
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src
frontend/src/**
!frontend/src/*.tsx
!frontend/src/*.ts
!frontend/src/*.css
!frontend/src/api
frontend/src/api/**
!frontend/src/api/*.ts
!frontend/src/components
frontend/src/components/**
!frontend/src/components/*.tsx
!frontend/src/hooks
frontend/src/hooks/**
!frontend/src/hooks/*.ts
!frontend/src/types
frontend/src/types/**
!frontend/src/types/*.ts
# Defense in depth for all admitted source directories.
**/.git
**/.aws
**/.venv
**/node_modules
**/__pycache__
**/.pytest_cache
**/.DS_Store
**/.env*
**/*.db
**/*.sqlite*
**/*.pem
**/*.key
**/*.zip
**/*.csv
!demo/synthetic.csv
